# Copier ce fichier en ".env" (jamais versionné) et adapter.
N_SENSORS=1
INTERVAL_SECONDS=2.0
CLOUD_DELAY_SECONDS=0.2
EDGE_BATCH=5

# Scénario : reduce = edge-cloud (flux réduit), forward = cloud-only (tout au Cloud)
EDGE_MODE=reduce

# Semaine 2 : InfluxDB 2.x (valeurs à choisir, ne jamais les mettre dans Git)
INFLUX_USER=
INFLUX_PASSWORD=
INFLUX_ORG=
INFLUX_BUCKET=
INFLUX_TOKEN=
